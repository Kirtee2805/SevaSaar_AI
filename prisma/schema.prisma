datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id              String   @id @default(uuid())
  tokenNumber     String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  language        String   // en, hi, gu, mixed
  
  // Patient details
  name            String
  age             String
  gender          String
  phone           String
  location        String

  // Complaint & Extracted Summary
  rawComplaint    String
  chiefComplaint  String
  symptomsJson    String   // JSON string of symptoms array
  duration        String
  medicinesJson   String   // JSON string of medicines array
  conditionsJson  String   // JSON string of conditions array
  allergiesJson   String   // JSON string of allergies array
  missingJson     String   // JSON string of missing items array
  
  // Emergency indicators
  emergency       Boolean  @default(false)
  emergencyReason String?

  // Intake status
  status          String   @default("Waiting") // Waiting, Completed, Emergency
  notes           String?
  assignedDoctor  String?
}
